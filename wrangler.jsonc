/**
 * moho deployment: https://dragonknightk.com/moho (path routes, not a subdomain)
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (never committed), set with `wrangler secret put <NAME>`:
 *   AUTH_USERNAME       login name of the single beta account
 *   AUTH_PASSWORD_HASH  pbkdf2-sha256$100000$<salt>$<hash>  (see scripts/hash-password.mjs)
 *   SESSION_SECRET      random string used to sign the session cookie
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moho-burnafterread",
	"main": "worker/index.ts",
	"compatibility_date": "2026-04-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": false },
	"upload_source_maps": false,

	// Only reachable through the domain; no workers.dev / preview URLs
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "dragonknightk.com/moho", "zone_name": "dragonknightk.com" },
		{ "pattern": "dragonknightk.com/moho/*", "zone_name": "dragonknightk.com" }
	],

	"triggers": { "crons": ["0 * * * *"] },

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "moho-burnafterread-db",
			"database_id": "40fd8ffb-cc11-4843-a3a6-9f62cf0d2a6f",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "DROP_COORDINATOR", "class_name": "DropAccessCoordinator" },
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["DropAccessCoordinator", "RateLimiter"] }
	]
}
